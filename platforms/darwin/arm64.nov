// ---------------------------------------------------------------------------
// window/darwin_arm64 - macOS Apple Silicon window manager (WebKit)
// Spawns a C helper and communicates over a UNIX domain socket.
// ---------------------------------------------------------------------------

module window_darwin_arm64;


// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

fn wm_to_u8(v: i32) -> i32 {
    return ((v % 256) + 256) % 256;
}

fn wm_syscall0(nr: i64) -> u64 {
    mov(x16, 0x2000000 + nr);
    syscall();
    return getreg(x0);
}

fn wm_syscall1_i32(nr: i64, a0: i32) -> u64 {
    mov(x0, a0);
    mov(x16, 0x2000000 + nr);
    syscall();
    return getreg(x0);
}

fn wm_syscall3_i32(nr: i64, a0: i32, a1: i32, a2: i32) -> u64 {
    mov(x0, a0);
    mov(x1, a1);
    mov(x2, a2);
    mov(x16, 0x2000000 + nr);
    syscall();
    return getreg(x0);
}

fn wm_syscall3(nr: i64, a0: i32, a1: u64, a2: i32) -> u64 {
    mov(x0, a0);
    mov(x1, a1);
    mov(x2, a2);
    mov(x16, 0x2000000 + nr);
    syscall();
    return getreg(x0);
}

// ---------------------------------------------------------------------------
// Default paths
// ---------------------------------------------------------------------------

fn wm_sock_path_default() -> str {
    return "/tmp/novus_wm.sock";
}

fn wm_exe_default() -> str {
    return "lib/window/window_manager";
}

// ---------------------------------------------------------------------------
// UNIX domain socket helpers
// ---------------------------------------------------------------------------

fn wm_unlink(path: str) -> void {
    mov(x0, path);
    mov(x16, 0x2000000 + 10);
    syscall();
}

fn wm_sockaddr_un_make(path: str) -> str {
    let buf: str = "";
    let i: i32 = 0;
    while (i < 106) {
        buf = buf + "\0";
        i = i + 1;
    }
    buf[0] = wm_to_u8(106);
    buf[1] = wm_to_u8(1);   // AF_UNIX

    i = 0;
    while (i < 104) {
        if (path[i] == '\0') { break; }
        buf[2 + i] = wm_to_u8(path[i]);
        i = i + 1;
    }
    buf[2 + i] = 0;
    return buf;
}

// ---------------------------------------------------------------------------
// Socket client
// ---------------------------------------------------------------------------

fn wm_socket() -> i32 {
    wm_syscall3_i32(97, 1, 1, 0);  // AF_UNIX=1, SOCK_STREAM=1
    return u64_to_i32(getreg(x0));
}

fn wm_connect(sock_path: str) -> i32 {
    let fd: i32 = wm_socket();
    if (fd < 0) { return fd; }

    let addr: str = wm_sockaddr_un_make(sock_path);
    mov(x9, addr);
    let addr_ptr: u64 = getreg(x9);

    wm_syscall3(98, fd, addr_ptr, 106);  // SYS_connect
    let irc: i32 = u64_to_i32(getreg(x0));
    if (irc != 0) {
        wm_syscall1_i32(6, fd);
        return -1;
    }
    return fd;
}

fn wm_close(fd: i32) -> void {
    wm_syscall1_i32(6, fd);
}

// ---------------------------------------------------------------------------
// Send / Receive
// ---------------------------------------------------------------------------

fn wm_send_line(fd: i32, line: str) -> i32 {
    let n: i32 = len(line);
    mov(x9, line);
    let p: u64 = getreg(x9);
    wm_syscall3(4, fd, p, n);
    return u64_to_i32(getreg(x0));
}

fn wm_escape_arg(arg: str) -> str {
    let out: str = "";
    let i: i32 = 0;
    while (i < len(arg)) {
        if (arg[i] == '\\') {
            out = out + "\\\\";
        } else if (arg[i] == '\n') {
            out = out + "\\n";
        } else if (arg[i] == '\r') {
            // skip
        } else {
            out = out + arg[i];
        }
        i = i + 1;
    }
    return out;
}

fn wm_unescape_arg(arg: str) -> str {
    let out: str = "";
    let i: i32 = 0;
    while (i < len(arg)) {
        if (arg[i] == '\\') {
            if (i + 1 < len(arg)) {
                if (arg[i + 1] == 'n') {
                    out = out + "\n";
                    i = i + 2;
                } else if (arg[i + 1] == '\\') {
                    out = out + "\\";
                    i = i + 2;
                } else {
                    out = out + arg[i];
                    i = i + 1;
                }
            } else {
                out = out + arg[i];
                i = i + 1;
            }
        } else {
            out = out + arg[i];
            i = i + 1;
        }
    }
    return out;
}

fn wm_send_cmd(fd: i32, cmd: str, arg: str) -> i32 {
    let line: str = cmd;
    if (len(arg) > 0) {
        line = line + " " + wm_escape_arg(arg);
    }
    line = line + "\n";
    return wm_send_line(fd, line);
}

fn wm_recv_line(fd: i32, buf_len: i32) -> str {
    let buf: str = "";
    let i: i32 = 0;
    while (i < buf_len) {
        buf = buf + " ";
        i = i + 1;
    }

    let out: str = "";
    let pos: i32 = 0;
    while (pos < buf_len) {
        mov(x9, buf);
        let bptr: u64 = getreg(x9);
        wm_syscall3(3, fd, bptr, 1);
        let nread: i32 = u64_to_i32(getreg(x0));
        if (nread <= 0) { break; }
        if (buf[0] == '\n') { break; }
        if (buf[0] == '\r') {
            // skip
        } else {
            out = out + buf[0];
        }
        pos = pos + 1;
    }
    return out;
}

fn wm_recv_ok(fd: i32) -> str {
    return wm_recv_line(fd, 64);
}

fn wm_parse_size_value(line: str, token_index: i32) -> i32 {
    let i: i32 = 0;
    let current: i32 = 0;

    while (i < len(line)) {
        while (i < len(line) && line[i] == ' ') { i = i + 1; }
        if (i >= len(line)) { return -1; }

        let start: i32 = i;
        while (i < len(line) && line[i] != ' ') { i = i + 1; }
        if (current == token_index) {
            return str_to_i32(substr_len(line, start, i - start));
        }
        current = current + 1;
    }

    return -1;
}

// ---------------------------------------------------------------------------
// Sleep helper (used for connection retry)
// ---------------------------------------------------------------------------

fn wm_sleep_ms(ms: i32) -> void {
    mov(x0, 0);
    mov(x1, 0);
    mov(x2, ms);
    mov(x16, 0x2000000 + 230);  // SYS_poll
    syscall();
}

fn wm_write_i32_le(buf: str, offset: i32, val: i32) -> void {
    let v: i32 = val;
    let i: i32 = 0;
    while (i < 4) {
        buf[offset + i] = wm_to_u8(v % 256);
        v = v / 256;
        i = i + 1;
    }
}

// ---------------------------------------------------------------------------
// Spawn & connect
// ---------------------------------------------------------------------------

fn wm_spawn(exe_path: str, sock_path: str, title: str, auto_show: bool) -> i32 {
    if (len(sock_path) == 0) {
        sock_path = wm_sock_path_default();
    }

    let arg_socket: str = "--socket";
    let arg_title: str = "--title";
    let arg_auto: str = "--auto-show";

    let argv: []u64 = [
        ptr(exe_path),
        ptr(arg_socket), ptr(sock_path),
        ptr(arg_title), ptr(title),
        0
    ];

    if (auto_show) {
        argv = [
            ptr(exe_path),
            ptr(arg_socket), ptr(sock_path),
            ptr(arg_title), ptr(title),
            ptr(arg_auto),
            0
        ];
    }

    return spawn_execve(exe_path, argv);
}

fn wm_start_auto(exe_path: str, sock_path: str, title: str) -> i32 {
    if (len(exe_path) == 0) {
        exe_path = wm_exe_default();
    }
    if (len(sock_path) == 0) {
        sock_path = wm_sock_path_default();
    }

    wm_unlink(sock_path);

    let pid: i32 = wm_spawn(exe_path, sock_path, title, false);
    if (pid < 0) {
        print("Failed to spawn window manager process.");
        return -1;
    }

    let fd: i32 = -1;
    let attempts: i32 = 0;
    while (attempts < 40) {
        wm_sleep_ms(50);
        fd = wm_connect(sock_path);
        if (fd >= 0) { break; }
        attempts = attempts + 1;
    }

    if (fd < 0) {
        print("Failed to connect to window manager after retries.");
    }
    return fd;
}

fn wm_start(sock_path: str) -> i32 {
    if (len(sock_path) == 0) {
        sock_path = wm_sock_path_default();
    }
    return wm_connect(sock_path);
}

// ---------------------------------------------------------------------------
// Public API — window control + graphics
// Mirrors the Linux (X11) backend so cross-platform Novus apps can call the
// same wm_* functions. The Cocoa helper binary `lib/window/window_manager`
// owns the actual NSWindow + framebuffer.
// ---------------------------------------------------------------------------

fn wm_input_left()  -> i32 { return 1; }
fn wm_input_right() -> i32 { return 2; }
fn wm_input_jump()  -> i32 { return 4; }
fn wm_input_down()  -> i32 { return 8; }
fn wm_input_quit()  -> i32 { return 16; }

// Cached size + last-known input mask for wm_size() / wm_input().
let g_wm_width: i32 = 960;
let g_wm_height: i32 = 640;
let g_wm_size_cache: str = "";
let g_wm_size_cache_w: i32 = -1;
let g_wm_size_cache_h: i32 = -1;
let g_wm_fd: i32 = -1;

fn wm_open(title: str, exe_path: str, sock_path: str) -> i32 {
    let fd: i32 = wm_start_auto(exe_path, sock_path, title);
    if (fd < 0) {
        print("ERROR: Could not start window manager.");
        exit(1);
        return -1;
    }
    g_wm_fd = fd;
    g_wm_width = 960;
    g_wm_height = 640;
    // Tell helper our intended size + title.
    let dims: str = int_to_str(g_wm_width) + " " + int_to_str(g_wm_height) + " " + title;
    wm_send_cmd(fd, "OPEN", dims);
    wm_recv_ok(fd);
    wm_send_cmd(fd, "SHOW", "");
    wm_recv_ok(fd);
    return fd;
}

fn wm_open_default(title: str) -> i32 {
    return wm_open(title, "", "");
}

fn wm_title(fd: i32, title: str) -> i32 {
    wm_send_cmd(fd, "TITLE", title);
    wm_recv_ok(fd);
    return 0;
}

fn wm_show(fd: i32) -> i32 {
    wm_send_cmd(fd, "SHOW", "");
    wm_recv_ok(fd);
    return 0;
}

fn wm_hide(fd: i32) -> i32 {
    wm_send_cmd(fd, "HIDE", "");
    wm_recv_ok(fd);
    return 0;
}

fn wm_ping(fd: i32) -> i32 {
    wm_send_cmd(fd, "PING", "");
    wm_recv_ok(fd);
    return 0;
}

fn wm_quit(fd: i32) -> i32 {
    wm_send_cmd(fd, "QUIT", "");
    wm_recv_ok(fd);
    wm_close(fd);
    g_wm_fd = -1;
    return 0;
}

fn wm_resize(fd: i32, width: i32, height: i32) -> i32 {
    if (width > 0)  { g_wm_width = width; }
    if (height > 0) { g_wm_height = height; }
    let size: str = int_to_str(g_wm_width) + " " + int_to_str(g_wm_height);
    wm_send_cmd(fd, "RESIZE", size);
    wm_recv_ok(fd);
    return 0;
}

// ---------------------------------------------------------------------------
// Drawing API
// CLEAR/RECT are fire-and-forget for throughput; PRESENT round-trips and
// returns the current input mask piggybacked on its OK reply.
// ---------------------------------------------------------------------------

fn wm_clear(fd: i32, color: i32) -> i32 {
    wm_send_cmd(fd, "CLEAR", int_to_str(color));
    return 0;
}

fn wm_rect(fd: i32, x: i32, y: i32, width: i32, height: i32, color: i32) -> i32 {
    let line: str = "RECT " + int_to_str(x) + " " + int_to_str(y) + " "
                  + int_to_str(width) + " " + int_to_str(height) + " "
                  + int_to_str(color) + "\n";
    wm_send_line(fd, line);
    return 0;
}

// Parse the trailing input mask from "OK <n>\n".
fn wm_parse_mask(line: str) -> i32 {
    let i: i32 = 0;
    while (i < len(line) && line[i] != ' ') { i = i + 1; }
    while (i < len(line) && line[i] == ' ') { i = i + 1; }
    let num: str = "";
    while (i < len(line)) { num = num + line[i]; i = i + 1; }
    if (len(num) == 0) { return 0; }
    return str_to_i32(num);
}

fn wm_present(fd: i32) -> i32 {
    wm_send_cmd(fd, "PRESENT", "");
    let resp: str = wm_recv_line(fd, 64);
    return wm_parse_mask(resp);
}

fn wm_input(fd: i32) -> i32 {
    wm_send_cmd(fd, "INPUT", "");
    let resp: str = wm_recv_line(fd, 64);
    return wm_parse_mask(resp);
}

fn wm_size(fd: i32) -> str {
    wm_send_cmd(fd, "SIZE", "");
    let resp: str = wm_recv_line(fd, 64);
    let width: i32 = wm_parse_size_value(resp, 1);
    let height: i32 = wm_parse_size_value(resp, 2);
    if (width > 0) { g_wm_width = width; }
    if (height > 0) { g_wm_height = height; }
    if (g_wm_size_cache_w != g_wm_width || g_wm_size_cache_h != g_wm_height) {
        g_wm_size_cache = int_to_str(g_wm_width) + "x" + int_to_str(g_wm_height);
        g_wm_size_cache_w = g_wm_width;
        g_wm_size_cache_h = g_wm_height;
    }
    return g_wm_size_cache;
}
