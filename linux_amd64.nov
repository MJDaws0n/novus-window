// ---------------------------------------------------------------------------
// window/linux_amd64 - Linux X11 window helper over localhost TCP
// ---------------------------------------------------------------------------

module window_linux_amd64;

import ../std;
import ../net/main;
import ../env/main;

fn wm_default_port() -> i32 {
    mov(rax, 39); // SYS_getpid
    syscall();
    let pid: i32 = u64_to_i32(getreg(rax));
    return 42000 + (pid % 20000);
}

fn wm_exe_default() -> str {
    return "lib/window/window_manager_linux";
}

fn wm_input_left() -> i32 { return 1; }
fn wm_input_right() -> i32 { return 2; }
fn wm_input_jump() -> i32 { return 4; }
fn wm_input_down() -> i32 { return 8; }
fn wm_input_quit() -> i32 { return 16; }

fn wm_sleep_ms(ms: i32) -> void {
    mov(rax, 7);
    mov(rdi, 0);
    mov(rsi, 0);
    mov(rdx, ms);
    syscall();
}

fn wm_send_line(fd: i32, line: str) -> i32 {
    return net_write_line(fd, line);
}

fn wm_recv_line(fd: i32) -> str {
    return net_read_line(fd, 4096);
}

fn wm_send_cmd(fd: i32, cmd: str, arg: str) -> i32 {
    if (len(arg) > 0) {
        return wm_send_line(fd, cmd + " " + arg);
    }
    return wm_send_line(fd, cmd);
}

fn wm_trim_line(line: str) -> str {
    let out: str = "";
    let i: i32 = 0;
    while (i < len(line)) {
        if (line[i] == '\n' || line[i] == '\r') {
            return out;
        }
        out = out + line[i];
        i = i + 1;
    }
    return out;
}

fn wm_line_has_prefix(line: str, prefix: str) -> bool {
    if (len(line) < len(prefix)) { return false; }
    return str_equals(substr_len(line, 0, len(prefix)), prefix);
}

fn wm_parse_tail_i32(line: str, prefix: str) -> i32 {
    if (!wm_line_has_prefix(line, prefix)) { return 0; }
    return str_to_i32(substr_len(line, len(prefix), len(line) - len(prefix)));
}

fn wm_size(fd: i32) -> str {
    wm_send_cmd(fd, "SIZE", "");
    let line: str = wm_recv_line(fd);
    if (!wm_line_has_prefix(line, "SIZE ")) { return ""; }
    return substr_len(line, 5, len(line) - 5);
}

fn wm_connect_port(port: i32) -> i32 {
    return net_connect_local(port);
}

fn wm_quit_fd(fd: i32) -> void {
    wm_send_cmd(fd, "QUIT", "");
    wm_recv_line(fd);
    net_close(fd);
}

fn wm_stop_stale_helper(port: i32) -> void {
    let stale_fd: i32 = wm_connect_port(port);
    if (stale_fd >= 0) {
        wm_quit_fd(stale_fd);
        wm_sleep_ms(100);
    }
}

fn wm_spawn_linux(exe_path: str, title: str, port: i32, width: i32, height: i32) -> i32 {
    let arg_port: str = "--port";
    let arg_title: str = "--title";
    let arg_width: str = "--width";
    let arg_height: str = "--height";
    let arg_display: str = "--display";
    let arg_xauthority: str = "--xauthority";
    let arg_home: str = "--home";
    let port_str: str = int_to_str(port);
    let width_str: str = int_to_str(width);
    let height_str: str = int_to_str(height);
    let display_str: str = wm_trim_line(getenv("DISPLAY"));
    let xauthority_str: str = wm_trim_line(getenv("XAUTHORITY"));
    let home_str: str = wm_trim_line(get_home_dir());
    let argv: []u64 = [
        ptr(exe_path),
        ptr(arg_display), ptr(display_str),
        ptr(arg_xauthority), ptr(xauthority_str),
        ptr(arg_home), ptr(home_str),
        ptr(arg_port), ptr(port_str),
        ptr(arg_title), ptr(title),
        ptr(arg_width), ptr(width_str),
        ptr(arg_height), ptr(height_str),
        0
    ];
    return spawn_execve(exe_path, argv);
}

fn wm_open(title: str, exe_path: str, sock_path: str) -> i32 {
    if (len(exe_path) == 0) {
        exe_path = wm_exe_default();
    }

    let port: i32 = wm_default_port();
    wm_stop_stale_helper(port);

    let pid: i32 = wm_spawn_linux(exe_path, title, port, 960, 640);
    if (pid < 0) {
        return -1;
    }

    let attempts: i32 = 0;
    let fd: i32 = -1;
    while (attempts < 80) {
        fd = wm_connect_port(port);
        if (fd >= 0) {
            return fd;
        }
        wm_sleep_ms(50);
        attempts = attempts + 1;
    }
    return -1;
}

fn wm_open_default(title: str) -> i32 {
    return wm_open(title, "", "");
}

fn wm_title(fd: i32, title: str) -> i32 {
    wm_send_cmd(fd, "TITLE", title);
    wm_recv_line(fd);
    return 0;
}

fn wm_resize(fd: i32, width: i32, height: i32) -> i32 {
    wm_send_cmd(fd, "RESIZE", int_to_str(width) + "x" + int_to_str(height));
    wm_recv_line(fd);
    return 0;
}

fn wm_show(fd: i32) -> i32 {
    wm_send_cmd(fd, "SHOW", "");
    wm_recv_line(fd);
    return 0;
}

fn wm_hide(fd: i32) -> i32 {
    wm_send_cmd(fd, "HIDE", "");
    wm_recv_line(fd);
    return 0;
}

fn wm_ping(fd: i32) -> i32 {
    wm_send_cmd(fd, "PING", "");
    wm_recv_line(fd);
    return 0;
}

fn wm_quit(fd: i32) -> i32 {
    wm_send_cmd(fd, "QUIT", "");
    wm_recv_line(fd);
    net_close(fd);
    return 0;
}

fn wm_clear(fd: i32, color: i32) -> i32 {
    wm_send_cmd(fd, "CLEAR", int_to_str(color));
    wm_recv_line(fd);
    return 0;
}

fn wm_rect(fd: i32, x: i32, y: i32, width: i32, height: i32, color: i32) -> i32 {
    let payload: str = int_to_str(x) + " " + int_to_str(y) + " " + int_to_str(width) + " " + int_to_str(height) + " " + int_to_str(color);
    wm_send_cmd(fd, "RECT", payload);
    wm_recv_line(fd);
    return 0;
}

fn wm_present(fd: i32) -> i32 {
    wm_send_cmd(fd, "PRESENT", "");
    wm_recv_line(fd);
    return 0;
}

fn wm_input(fd: i32) -> i32 {
    wm_send_cmd(fd, "INPUT", "");
    let line: str = wm_recv_line(fd);
    return wm_parse_tail_i32(line, "INPUT ");
}
